# Toggle Concepts client dashboard. Copy to .env.local and fill in.
# The same Supabase project and R2 bucket as Forma (see forma/docs/cloud-runbook.md).

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=forma

# Separate origin that serves model-written creatives (never the dashboard's origin).
# Locally, e.g. http://play.localhost:3000
NEXT_PUBLIC_PLAYER_ORIGIN=

# 1 = brand switcher, "New brand", studio simulator, /styleguide. Never in production.
DASHBOARD_TEST_MODE=1
